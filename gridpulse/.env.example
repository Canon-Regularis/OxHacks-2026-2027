# Proposed backend settings; loading/validation is not implemented yet.
# Copy to a local .env file. Never expose this file's real values to frontend code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Local same-origin proxy/API routing is configured when frameworks are chosen.
FRONTEND_ORIGIN=http://localhost:5173
# Optional Gemini extension; not required for the MVP.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional Snowflake exploration; not required for the MVP.
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_MODEL=
