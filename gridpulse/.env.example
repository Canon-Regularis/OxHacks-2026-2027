# Backend settings, loaded by gridpulse/backend/src/gridpulse/config.py.
# Copy to gridpulse/.env. Never expose this file's real values to frontend code.
# The database URL can instead come from Tiger Cloud's downloaded tiger-cloud-<service>-credentials.env
# (TIMESCALE_SERVICE_URL) saved in the repository root; a DATABASE_URL here takes precedence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Only needed when the frontend dev server is on another origin; production proxies /api.
FRONTEND_ORIGIN=http://localhost:5173
# live | record (also save responses for the offline demo) | replay (serve saved responses, no DB)
GRIDPULSE_MODE=live
# Response bounds; defaults shown.
MAX_POINTS=5000
MAX_RANGE_DAYS=3660
QUERY_TIMEOUT_SECONDS=15
# Deployment only (gridpulse/deploy/README.md): which environment's stack this is, the image tag
# `docker compose up` uses (production or main), and the VPS-local port for curl.
DEPLOY_ENV=production
IMAGE_TAG=production
BACKEND_PORT=8000
# CWaveAPI key for calling llm
CWAVE_API_KEY=
# Optional Gemini extension; not required for the MVP.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional Snowflake exploration; not required for the MVP.
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_MODEL=
