# Baked into the frontend image. Serves the frontend build and proxies the API to this stack's
# backend on the same origin, so the browser needs no CORS and no backend URL. HTTPS is
# terminated in front of it by the shared proxy (proxy/Caddyfile).
{
	servers {
		# Keep the proxy's X-Forwarded-* headers (client IP, https) when passing requests on.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	@backend path /api/* /docs /docs/* /openapi.json
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Hashed bundles never change; everything else is revalidated so a deploy shows up at once.
		@immutable path /assets/* /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@mutable not path /assets/* /_app/immutable/*
		header @mutable Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
