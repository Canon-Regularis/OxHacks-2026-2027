# Baked into the frontend image. Serves the frontend build and proxies the API to the backend
# container on the same origin, so the browser needs no CORS and no backend URL.
#
# SITE_ADDRESS is a domain for automatic HTTPS (e.g. gridpulse.example.com, or 203-0-113-10.sslip.io
# for a bare IP), or :80 for plain HTTP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@backend path /api/* /docs /docs/* /openapi.json
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Hashed bundles never change; everything else is revalidated so a deploy shows up at once.
		@immutable path /assets/* /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@mutable not path /assets/* /_app/immutable/*
		header @mutable Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
